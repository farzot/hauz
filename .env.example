# ---------------------------------------------------------------------------
# HAUZ backend task — environment
#
# Copy to `.env` and fill in. Every value below is read at runtime; nothing
# about a specific Appwrite project is compiled into the application.
#
#   cp .env.example .env
#
# The file is a convenience, not a requirement: everything is read from
# `process.env`, so exporting these variables in your shell, your CI settings or
# a secret manager works exactly the same and keeps the keys out of any file.
# ---------------------------------------------------------------------------

# Appwrite API endpoint, including the /v1 suffix.
# Appwrite Cloud: https://<region>.cloud.appwrite.io/v1  (e.g. https://fra.cloud.appwrite.io/v1)
# Self-hosted:    https://appwrite.example.com/v1
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1

# Appwrite project id (Console → Overview).
APPWRITE_PROJECT_ID=

# Server-side API key (Console → Overview → Integrations → API keys).
# Never exposed to the browser. Required scopes:
#   users.read, users.write              create the Auth user, store its profile
#   sessions.write                       open an email/password session server-side
#   databases.read, databases.write      setup script: create the database
#   tables.read, tables.write            setup script: create tables
#   columns.read, columns.write          setup script: create columns
#   indexes.read, indexes.write          setup script: create indexes
#   rows.read, rows.write                setup script: seed personal_roles
#   functions.read                       preflight: check the function is deployed
# The application itself only needs the first three groups; the rest are used by
# `npm run setup:appwrite` and `npm run preflight`. The Appwrite Function does
# NOT use this key — it receives a scoped dynamic key at execution time.
APPWRITE_API_KEY=

# Database id. The setup script creates it if it does not exist.
APPWRITE_DATABASE_ID=hauz
APPWRITE_DATABASE_NAME=HAUZ

# Id of the deployed provisioning function (Console → Functions → Settings).
APPWRITE_PROVISIONING_FUNCTION_ID=hauz-account-provisioning

# Public origin used to build the email-verification link.
# Optional: when unset, the origin of the incoming request is used, which is
# usually what you want locally and on preview deployments. The hostname must be
# registered as a Web platform in the Appwrite console either way.
# APP_URL=http://localhost:3000

# Name of the cookie holding the Appwrite session secret.
SESSION_COOKIE_NAME=hauz_session

# ---------------------------------------------------------------------------
# There is nothing to configure for the verification email. Appwrite mints,
# renders and sends it over the project's SMTP; two console settings decide
# whether it arrives, and neither is an environment variable:
#
#   Settings → Platforms   a Web platform for this hostname, or Appwrite refuses
#                          the verification url outright
#   Auth → SMTP            custom SMTP. The shared Appwrite Cloud sender works
#                          but is rate-limited and often filtered as spam
#
# If a message never arrives, switch "Email verification" on for the user in
# Auth → Users; the app picks that up on the next page load.
# ---------------------------------------------------------------------------
